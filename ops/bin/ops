#!/usr/bin/env bash
# ============================================================
# ops/bin/ops
# Purpose:  OPS main menu dispatcher (TUI entry point)
# Part of:  OPS — VPS Production Setup & Manager
# ============================================================
set -euo pipefail
IFS=$'\n\t'

# Resolve the real script path first so the /usr/local/bin symlink works.
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ "$SCRIPT_PATH" != /* ]] && SCRIPT_PATH="${SCRIPT_DIR}/${SCRIPT_PATH}"
done
OPS_ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# Source core helpers (always in this order)
# shellcheck source=core/env.sh
source "$OPS_ROOT/core/env.sh"
# shellcheck source=core/utils.sh
source "$OPS_ROOT/core/utils.sh"
# shellcheck source=core/ui.sh
source "$OPS_ROOT/core/ui.sh"
# shellcheck source=core/system.sh
source "$OPS_ROOT/core/system.sh"

# ── Load all modules (sourced, not executed) ─────────────────
# shellcheck source=modules/setup-wizard.sh
source "$OPS_ROOT/modules/setup-wizard.sh"
# shellcheck source=modules/security.sh
source "$OPS_ROOT/modules/security.sh"
# shellcheck source=modules/nginx.sh
source "$OPS_ROOT/modules/nginx.sh"
# shellcheck source=modules/node.sh
source "$OPS_ROOT/modules/node.sh"
# shellcheck source=modules/nine-router.sh
source "$OPS_ROOT/modules/nine-router.sh"
# shellcheck source=modules/php.sh
source "$OPS_ROOT/modules/php.sh"
# shellcheck source=modules/database.sh
source "$OPS_ROOT/modules/database.sh"
# shellcheck source=modules/monitoring.sh
source "$OPS_ROOT/modules/monitoring.sh"
# shellcheck source=modules/verify.sh
source "$OPS_ROOT/modules/verify.sh"
# shellcheck source=modules/checks.sh
source "$OPS_ROOT/modules/checks.sh"
# shellcheck source=modules/backup.sh
source "$OPS_ROOT/modules/backup.sh"
# shellcheck source=modules/codex-cli.sh
source "$OPS_ROOT/modules/codex-cli.sh"
# shellcheck source=modules/ai-agent.sh
source "$OPS_ROOT/modules/ai-agent.sh"

# ── Main menu loop ────────────────────────────────────────────
main_menu() {
    while true; do
        clear
        print_section "OPS — VPS Production Manager"
        echo "  System: ${OS_ID:-unknown} ${OS_VERSION_ID:-}  |  Tier: ${OPS_TIER:-?}  |  RAM: ${RAM_MB:-?}MB  |  CPU: ${CPU_CORES:-?}"
        echo ""
        ops_print_update_banner 2>/dev/null || true
        echo "  1) Production Setup Wizard"
        echo "  2) Node.js Services"
        echo "  3) Domains & Nginx"
        echo "  4) SSL Management"
        echo "  5) 9router Management"
        echo "  6) PHP / PHP-FPM Management"
        echo "  7) Database Management"
        echo "  8) AI Agent Integration"
        echo "  9) System & Monitoring"
        echo "  s) Security Management"
        echo "  0) Exit"
        echo ""
        # F-SPIN: read with 5-min timeout — exits cleanly if tty dies mid-session
        # (prevents 100% CPU spin loop when SSH disconnects with ops open)
        printf "Select: " > /dev/tty
        if ! read -r -t 300 choice < /dev/tty; then
            echo "" >&2
            exit 0
        fi
        case "$choice" in
            # F-02: Each arm guarded with || true so that any non-zero return from a
            # sub-function (e.g. stopped service, pm2 not found, sshd -T on container)
            # does NOT propagate through set -euo pipefail and silently kill the TUI.
            # Internal errors are still logged/printed by the functions themselves.
            1) menu_setup_wizard   || true ;;
            2) menu_node           || true ;;
            3) menu_nginx          || true ;;
            4) menu_ssl            || true ;;
            5) menu_nine_router    || true ;;
            6) menu_php            || true ;;
            7) menu_database       || true ;;
            8) menu_ai_agent       || true ;;
            9) menu_monitoring     || true ;;
            s|S) menu_security     || true ;;
            0) exit 0              ;;
            *) print_warn "Invalid option — choose 0..9 or s"; sleep 0.5 ;;
        esac
    done
}

# ── F-13: Session lock ───────────────────────────────────────
# Prevents two concurrent 'ops' sessions from corrupting shared state
# (config files, service restarts, PM2 saves, UFW rules, etc.).
#
# Uses flock(1) on a file descriptor opened against /run/lock/ops-menu.lock:
#   • /run/lock has sticky-bit (1777) — world-writable but each user can
#     only delete their own files, so no unprivileged tampering.
#   • flock is atomic — no TOCTOU window between check and acquire.
#   • Works for both 'ops' (opsuser) and 'sudo ops' (root): flock operates
#     on the fd, not the file owner, so no AppArmor/ownership conflict.
OPS_LOCK_FILE="/run/lock/ops-menu.lock"
OPS_LOCK_FD=9

# Open/create the lock file on fd 9.
exec 9>"$OPS_LOCK_FILE" || {
    echo "[ERROR] Cannot open lock file $OPS_LOCK_FILE" >&2
    exit 1
}

# Attempt a non-blocking exclusive lock.
if ! flock -n 9 2>/dev/null; then
    _ops_old_pid=$(cat "$OPS_LOCK_FILE" 2>/dev/null || true)
    echo "[ERROR] Another ops session is already running${_ops_old_pid:+ (PID $_ops_old_pid)}." >&2
    echo "        Exit that session first, then run 'ops' again." >&2
    exec 9>&-
    exit 1
fi

# Write our PID into the locked file (informational — shown on conflict above).
echo "$$" >&9

# Lock is released automatically when fd 9 is closed (process exits).
# The trap also removes the file to keep /run/lock tidy.
trap 'flock -u 9; exec 9>&-; rm -f "$OPS_LOCK_FILE" 2>/dev/null || true' EXIT INT TERM HUP

# F-SPIN: Guard — require an interactive terminal before entering the menu loop.
# If stdin/stdout are not a TTY (e.g. piped, or tty already deleted), exit cleanly
# rather than spinning the while-true loop at 100% CPU forever.
if ! { [ -t 0 ] || [ -t 1 ]; }; then
    echo "[ERROR] 'ops' requires an interactive terminal. Run: sudo ops" >&2
    exec 9>&-
    exit 1
fi

main_menu
